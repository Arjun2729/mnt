# ---------------------------------------------------------------------------
# AI analyst — any OpenAI-compatible endpoint works.
#
# Google Gemini has a free tier and needs no payment method:
#   1. Sign in at https://aistudio.google.com/apikey
#   2. Create an API key
#   3. Paste it below, or into the Analyst tab
# ---------------------------------------------------------------------------

LLM_PROVIDER=Google Gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash-lite

# Other providers — set LLM_PROVIDER to one of:
#   Google Gemini | Groq | OpenRouter | Ollama (local) | OpenAI | Custom (OpenAI-compatible)
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# LLM_API_KEY=            # generic fallback, used if the specific one is unset

# --- Security ---
# The API connector refuses every host that is not listed here.
GT_ALLOWED_API_HOSTS=

# --- Scheduled alert worker ---
ALERT_SOURCE=file
ALERT_DATA_PATH=sample_data.csv
# ALERT_DATA_URL=
# ALERT_DATA_JSON_PATH=data.items
# ALERT_DB_URL=
# ALERT_DB_QUERY=
ALERT_RULES_FILE=alerts.json
ALERT_STATE_FILE=alert_state.json
ALERT_WEBHOOK_URL=
ALERT_TIME_COLUMN=date
ALERT_TIME_GRAIN=month
